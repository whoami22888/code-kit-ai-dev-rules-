{
  "name": "@warren-dean/code-kit",
  "version": "0.26.1",
  "description": "Shared AI engineering rules and CLI verification for ChatGPT, Codex and Claude Code",
  "license": "MIT",
  "author": "Warren Langeveldt",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warrendeanlangeveldt/code-kit.git"
  },
  "homepage": "https://github.com/warrendeanlangeveldt/code-kit#readme",
  "bugs": "https://github.com/warrendeanlangeveldt/code-kit/issues",
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "ai-agents",
    "guardrails",
    "architecture",
    "ci",
    "chatgpt",
    "codex",
    "agents-md",
    "ai-development"
  ],
  "bin": {
    "code-kit": "bin/code-kit.mjs",
    "code-kit-ai": "bin/code-kit-ai.mjs"
  },
  "files": [
    "bin",
    "hooks",
    "!hooks/**/*.test.ts",
    "skills",
    "templates",
    ".claude-plugin",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/units.test.mjs && node --test test/openai-dev.test.mjs && node test/hooks.test.mjs && node test/mod.mjs",
    "test:openai": "node --test test/openai-dev.test.mjs",
    "agent:doctor:self": "node bin/code-kit-ai.mjs doctor --self"
  }
}
